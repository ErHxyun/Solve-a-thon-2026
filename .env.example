# Copy to .env and fill in. NEVER commit .env. Get real values from the lead privately.

# --- Azure OpenAI ---
AOAI_ENDPOINT=https://aoai-ffm-10352.openai.azure.com/
AOAI_KEY=
AOAI_API_VERSION=2025-04-01-preview
AOAI_CHAT_DEPLOYMENT=chat                 # gpt-6.1-terra (reasoning-style: no temperature)
AOAI_FALLBACK_DEPLOYMENT=chat-fallback    # gpt-4.1 (supports temperature 0)
AOAI_EMBED_DEPLOYMENT=embed               # text-embedding-3-large
# Deployments that reject `temperature` and accept `reasoning_effort`
AOAI_REASONING_DEPLOYMENTS=chat,chat-sol,chat-luna,chat-astra

# --- Storage ---
STORAGE_MODE=local                        # local -> ./data ; blob -> Azure Blob
STORAGE_CONN=
STORAGE_CONTAINER=ffm-data

# --- Pipeline ---
AGENCY=dncr
TOP_N=15
COLLECTOR_MODE=fixture                    # fixture -> tests/fixtures ; live -> Grants.gov API
LLM_ENABLED=false                         # false -> agents use offline placeholders (no API calls)
COLLECTOR_CAP=5000                        # max listings per live run
COLLECTOR_WORKERS=8                       # parallel detail fetches
COLLECTOR_CACHE_HOURS=20                  # reuse details fetched within this window

# --- Email (agents/notifier.py; see docs/agents/notifier.md) ---
EMAIL_MODE=preview                        # off | preview (render only, default) | acs | smtp
EMAIL_TO=                                 # comma-separated recipients
EMAIL_FROM=                               # ACS: DoNotReply@<your-domain>.azurecomm.net ; SMTP: the account address
EMAIL_REPLY_TO=                           # optional
APP_URL=http://localhost:8000             # links in the email open this site (#today, #item-<id>)
EMAIL_WEEKLY_DAY=mon                      # weekly digest day (Eastern time)
EMAIL_URGENT=off                          # on = also send a same-day email for urgent items (default: weekly only)
EMAIL_URGENT_NEW_DAYS=45                  # new match closing within N days -> same-day email
EMAIL_URGENT_CLOSING_DAYS=7               # chased item closing within N days -> same-day email
EMAIL_DEADLINE_WINDOW_DAYS=30             # weekly "Deadlines" section horizon
# Azure Communication Services (EMAIL_MODE=acs) — a secret: Container Apps secretref, never commit
EMAIL_ACS_CONNECTION_STRING=
# SMTP (EMAIL_MODE=smtp), e.g. Gmail with an app password: smtp.gmail.com / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
